{
  "name": "opentype-parser",
  "description": "OpenType.JS (font parser only)",
  "author": {
    "name": "Frederik De Bleser",
    "email": "frederik@debleser.be"
  },
  "contributors": [
    "Marcelo Lv Cabral <marcelo@lvcabral.com>"
  ],
  "version": "1.3.5",
  "keywords": [
    "graphics",
    "fonts",
    "font",
    "opentype",
    "otf",
    "ttf",
    "woff",
    "type"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/opentypejs/opentype.js.git"
  },
  "main": "./dist/opentype.js",
  "browser": "./dist/opentype.js",
  "module": "./dist/opentype.module.js",
  "scripts": {
    "build": "npm run build:esm && npm run build:iife",
    "build:esm": "esbuild src/opentype.mjs --bundle --format=esm --outfile=dist/opentype.module.js --target=es2018 --sourcemap",
    "build:iife": "esbuild src/opentype.mjs --bundle --format=iife --global-name=opentype --outfile=dist/opentype.js --target=es2018 --sourcemap",
    "dist": "npm run dist:esm && npm run dist:iife",
    "dist:esm": "esbuild src/opentype.mjs --bundle --format=esm --outfile=dist/opentype.module.min.js --target=es2018 --minify --sourcemap",
    "dist:iife": "esbuild src/opentype.mjs --bundle --format=iife --global-name=opentype --outfile=dist/opentype.min.js --target=es2018 --minify --sourcemap",
    "test": "mocha --recursive",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "eslint": "^9.10.0",
    "mocha": "^10.7.3"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false
}
